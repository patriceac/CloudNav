#include <windows.h>
#include "resource.h"

#pragma code_page(65001)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDR_MANIFEST RT_MANIFEST "CloudNav.manifest"
IDI_CLOUDNAV ICON "CloudNav.ico"
IDR_ONEDRIVE_LOGO RCDATA "../assets/onedrive-official.png"
IDR_GOOGLE_DRIVE_LOGO RCDATA "../assets/google-drive-official.png"
IDR_RCLONE_EXE RCDATA "../.third-party/rclone/v1.75.0/rclone.exe"

IDD_CLOUD_MIGRATION DIALOGEX 0, 0, 500, 440
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CloudNav — cloud sync"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Compare OneDrive and Google Drive", IDC_DIALOG_HEADING, 16, 10, 468, 22
    LTEXT "Analyze both accounts once, then choose a transfer direction without comparing again.", -1, 16, 37, 468, 20
    CONTROL "I have paused all external synchronization between OneDrive and Google Drive.", IDC_MIGRATION_REMINDER, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 60, 468, 18
    CONTROL "", IDC_MIGRATION_ONEDRIVE_ICON, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 16, 91, 14, 14
    LTEXT "OneDrive", -1, 36, 92, 136, 12
    LTEXT "Not connected", IDC_MIGRATION_ONEDRIVE_STATUS, 183, 92, 180, 12
    PUSHBUTTON "Connect…", IDC_MIGRATION_ONEDRIVE_CONNECT, 384, 86, 100, 22
    CONTROL "", IDC_MIGRATION_GOOGLE_ICON, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 16, 122, 14, 14
    LTEXT "Google Drive", -1, 36, 123, 140, 12
    LTEXT "Not connected", IDC_MIGRATION_GOOGLE_STATUS, 183, 123, 180, 12
    PUSHBUTTON "Connect…", IDC_MIGRATION_GOOGLE_CONNECT, 384, 117, 100, 22
    CONTROL "", -1, "STATIC", SS_ETCHEDHORZ, 16, 152, 468, 1
    LTEXT "1 / 2 — Analyze before copying", IDC_MIGRATION_PHASE, 16, 164, 468, 16
    CONTROL "", IDC_MIGRATION_PROGRESS, "msctls_progress32", PBS_SMOOTH, 16, 187, 468, 14
    LTEXT "Waiting for analysis", IDC_MIGRATION_STATS, 16, 209, 468, 14
    LTEXT "Connect both accounts, then start the analysis.", IDC_MIGRATION_DETAILS, 16, 231, 468, 26
    LTEXT "Results will appear after analysis.", IDC_MIGRATION_SUMMARY, 16, 258, 468, 28
    LTEXT "Excluded (not counted): Personal Vault, native Google documents, .CloudNav-history archives.", -1, 16, 292, 370, 22
    PUSHBUTTON "View details…", IDC_MIGRATION_REPORT, 394, 288, 90, 22
    LTEXT "Transfer direction", -1, 16, 330, 96, 12
    COMBOBOX IDC_MIGRATION_MODE, 116, 326, 368, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_MIGRATION_PLAN, 16, 354, 468, 40
    PUSHBUTTON "Analyze", IDC_MIGRATION_ANALYZE, 16, 402, 82, 24
    PUSHBUTTON "Copy", IDC_MIGRATION_COPY, 106, 402, 108, 24
    PUSHBUTTON "Set up folders…", IDC_MIGRATION_CUTOVER, 222, 402, 156, 24
    PUSHBUTTON "Close", IDCANCEL, 394, 402, 90, 24
END

IDD_MIGRATION_REPORT DIALOGEX 0, 0, 620, 352
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CloudNav — analysis results"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Analysis results", IDC_DIALOG_HEADING, 16, 10, 588, 22
    LTEXT "", IDC_MIGRATION_SUMMARY, 16, 36, 588, 28
    LTEXT "Show", -1, 16, 75, 42, 12
    COMBOBOX IDC_REPORT_FILTER, 62, 71, 200, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_REPORT_LIST, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_OWNERDATA | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 16, 99, 588, 170
    EDITTEXT IDC_REPORT_SELECTED, 16, 277, 588, 30, ES_MULTILINE | ES_READONLY | ES_AUTOHSCROLL | WS_HSCROLL | WS_TABSTOP
    LTEXT "Identical under the comparison rules. Exclusions not counted: Personal Vault and native Google documents.", -1, 16, 316, 476, 23
    DEFPUSHBUTTON "Back", IDCANCEL, 524, 316, 80, 22
END

IDD_FOLDER_MANAGER DIALOGEX 0, 0, 540, 348
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CloudNav — personal folders"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Choose destinations, then review the changes before applying them.", -1, 16, 8, 508, 12
    LTEXT "", IDC_FOLDER_SUMMARY, 16, 23, 508, 12
    CONTROL "", IDC_FOLDER_DESKTOP_PROVIDER, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 16, 42, 12, 12
    LTEXT "Desktop", IDC_FOLDER_DESKTOP_LABEL, 34, 42, 288, 12
    COMBOBOX IDC_FOLDER_DESKTOP_TARGET, 344, 40, 180, 90, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Current:", -1, 16, 54, 40, 10
    EDITTEXT IDC_FOLDER_DESKTOP_PATH, 60, 53, 464, 11, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    LTEXT "Planned:", -1, 16, 65, 40, 10
    EDITTEXT 2004, 60, 64, 464, 11, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    CONTROL "", IDC_FOLDER_DOCUMENTS_PROVIDER, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 16, 76, 12, 12
    LTEXT "Documents", IDC_FOLDER_DOCUMENTS_LABEL, 34, 76, 288, 12
    COMBOBOX IDC_FOLDER_DOCUMENTS_TARGET, 344, 74, 180, 90, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Current:", -1, 16, 88, 40, 10
    EDITTEXT IDC_FOLDER_DOCUMENTS_PATH, 60, 87, 464, 11, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    LTEXT "Planned:", -1, 16, 99, 40, 10
    EDITTEXT 2014, 60, 98, 464, 11, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    CONTROL "", IDC_FOLDER_PICTURES_PROVIDER, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 16, 110, 12, 12
    LTEXT "Pictures", IDC_FOLDER_PICTURES_LABEL, 34, 110, 288, 12
    COMBOBOX IDC_FOLDER_PICTURES_TARGET, 344, 108, 180, 90, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Current:", -1, 16, 122, 40, 10
    EDITTEXT IDC_FOLDER_PICTURES_PATH, 60, 121, 464, 11, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    LTEXT "Planned:", -1, 16, 133, 40, 10
    EDITTEXT 2024, 60, 132, 464, 11, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    CONTROL "", IDC_FOLDER_DOWNLOADS_PROVIDER, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 16, 144, 12, 12
    LTEXT "Downloads", IDC_FOLDER_DOWNLOADS_LABEL, 34, 144, 288, 12
    COMBOBOX IDC_FOLDER_DOWNLOADS_TARGET, 344, 142, 180, 90, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Current:", -1, 16, 156, 40, 10
    EDITTEXT IDC_FOLDER_DOWNLOADS_PATH, 60, 155, 464, 11, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    LTEXT "Planned:", -1, 16, 167, 40, 10
    EDITTEXT 2034, 60, 166, 464, 11, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    CONTROL "", IDC_FOLDER_MUSIC_PROVIDER, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 16, 178, 12, 12
    LTEXT "Music", IDC_FOLDER_MUSIC_LABEL, 34, 178, 288, 12
    COMBOBOX IDC_FOLDER_MUSIC_TARGET, 344, 176, 180, 90, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Current:", -1, 16, 190, 40, 10
    EDITTEXT IDC_FOLDER_MUSIC_PATH, 60, 189, 464, 11, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    LTEXT "Planned:", -1, 16, 201, 40, 10
    EDITTEXT 2044, 60, 200, 464, 11, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    CONTROL "", IDC_FOLDER_VIDEOS_PROVIDER, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 16, 212, 12, 12
    LTEXT "Videos", IDC_FOLDER_VIDEOS_LABEL, 34, 212, 288, 12
    COMBOBOX IDC_FOLDER_VIDEOS_TARGET, 344, 210, 180, 90, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Current:", -1, 16, 224, 40, 10
    EDITTEXT IDC_FOLDER_VIDEOS_PATH, 60, 223, 464, 11, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    LTEXT "Planned:", -1, 16, 235, 40, 10
    EDITTEXT 2054, 60, 234, 464, 11, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    CONTROL "", -1, "STATIC", SS_ETCHEDHORZ, 16, 251, 508, 1
    LTEXT "Files:", -1, 16, 263, 44, 12
    COMBOBOX IDC_FOLDER_TRANSFER_MODE, 68, 259, 456, 75, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_FOLDER_WARNING, 16, 284, 508, 26
    LTEXT "Ready.", IDC_FOLDER_STATUS, 16, 320, 262, 22
    PUSHBUTTON "Refresh", IDC_FOLDER_REFRESH, 284, 317, 68, 22
    DEFPUSHBUTTON "Review…", IDOK, 360, 317, 98, 22
    PUSHBUTTON "Close", IDCANCEL, 466, 317, 58, 22
END

IDD_FOLDER_REVIEW DIALOGEX 0, 0, 540, 328
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CloudNav — review changes"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Review changes", IDC_DIALOG_HEADING, 16, 10, 508, 22
    LTEXT "Selected folders", -1, 16, 42, 508, 12
    EDITTEXT IDC_REVIEW_PLAN, 16, 59, 508, 104, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP, 0
    LTEXT "Effects on backup and other folders", -1, 16, 177, 508, 12
    EDITTEXT IDC_REVIEW_EFFECTS, 16, 194, 508, 62, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP, 0
    EDITTEXT IDC_REVIEW_NOTES, 16, 266, 508, 24, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP, 0
    PUSHBUTTON "Confirm", IDOK, 294, 298, 144, 22
    DEFPUSHBUTTON "Cancel", IDCANCEL, 446, 298, 78, 22
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,4,1,0
 PRODUCTVERSION 1,4,1,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "CloudNav\0"
      VALUE "FileDescription", "CloudNav - Windows cloud navigation\0"
      VALUE "FileVersion", "1.4.1\0"
      VALUE "InternalName", "CloudNav\0"
      VALUE "LegalCopyright", "Copyright (c) 2026 CloudNav contributors\0"
      VALUE "OriginalFilename", "CloudNav.exe\0"
      VALUE "ProductName", "CloudNav\0"
      VALUE "ProductVersion", "1.4.1\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
