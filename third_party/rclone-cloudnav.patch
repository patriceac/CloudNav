+// cloudNavAuthServer preserves the normal port when available. Google Drive and
+// OneDrive permit an ephemeral loopback port; other providers keep their URI.
+func cloudNavAuthServer(id string, opt *Options, oauthConfig *Config) (*authServer, error) {
+	server := newAuthServer(opt, bindAddress, "", "")
+	err := server.Init()
+	cloudNavProvider := id == "drive" || id == "onedrive"
+	loopbackRedirect := oauthConfig.RedirectURL == RedirectURL || oauthConfig.RedirectURL == RedirectLocalhostURL
+	if err != nil && cloudNavProvider && loopbackRedirect {
+		redirectHost := "127.0.0.1"
+		if oauthConfig.RedirectURL == RedirectLocalhostURL {
+			redirectHost = "localhost"
+		}
+		server = newAuthServer(opt, "127.0.0.1:0", "", "")
+		err = server.Init()
+		if err == nil {
+			_, port, splitErr := net.SplitHostPort(server.listener.Addr().String())
+			if splitErr != nil {
+				server.Stop()
+				return server, splitErr
+			}
+			// The caller uses this same config for the token exchange.
+			oauthConfig.RedirectURL = "http://" + net.JoinHostPort(redirectHost, port) + "/"
+		}
+	}
+	return server, err
+}
